# Copy this file to .env and fill in real values. Never commit .env.

BASE_URL= https://investigations-core-managed-arrived.trycloudflare.com
ADMIN_USER=admin
ADMIN_PASS=tap2review123
SESSION_SECRET=change-this-to-a-long-random-string-in-production

# ---- Paytm Payment Gateway ----
# Leave these unset/empty to run in dev mode (simulated payment, clearly
# labeled on-screen). Fill all three in to activate the real Paytm flow.
PAYTM_MID=
PAYTM_MERCHANT_KEY=
PAYTM_WEBSITE=WEBSTAGING
PAYTM_CHANNEL_ID=WEB
PAYTM_INDUSTRY_TYPE_ID=Retail
PAYTM_CALLBACK_URL=http://localhost:3000/api/payment/callback
PAYTM_ENV=STAGING

# Optional: override the fixed demo destination (defaults to https://www.google.com)
DEMO_DESTINATION_URL=
