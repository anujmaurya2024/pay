# Copy this file to .env and fill in real values. Never commit .env.

BASE_URL=https://www.tap2reviews.in
ADMIN_USER=admin
ADMIN_PASS=your-strong-password-here
SESSION_SECRET=change-this-to-a-long-random-string-in-production

# ---- Paytm Payment Gateway ----
# Leave these unset/empty to run in dev mode (simulated payment).
PAYTM_MID=
PAYTM_MERCHANT_KEY=
PAYTM_WEBSITE=WEBSTAGING
PAYTM_CHANNEL_ID=WEB
PAYTM_INDUSTRY_TYPE_ID=Retail
PAYTM_CALLBACK_URL=https://www.tap2reviews.in/api/payment/callback
PAYTM_ENV=STAGING

# Optional: override the fixed demo destination (defaults to https://www.google.com)
DEMO_DESTINATION_URL=
